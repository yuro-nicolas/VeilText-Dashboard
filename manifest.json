{
  "manifest_version": 3,
  "name": "VeilText - Profanity Filter",
  "version": "1.1.0",
  "description": "Real-time detection and filtering of undesired web content using a switchable Aho-Corasick or Wu-Manber engine.",
  "permissions": [
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "VeilText - Profanity Filter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["early-hide.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "all_frames": true,
      "js": [
        "src/namespace.js",

        "src/algorithms/aho-corasick.js",
        "src/algorithms/wu-manber.js",
        "src/algorithms/matcher-factory.js",

        "src/content/config.js",
        "src/content/state.js",
        "src/content/dom-utils.js",
        "src/content/reveal-ui.js",
        "src/content/stats.js",
        "src/content/filter-engine.js",
        "src/content/page-warning.js",
        "src/content/link-scanner.js",
        "src/content/observer.js",
        "src/content/messaging.js",
        "src/content/styles.js",
        "src/content/main.js"
      ]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/*.png", "data/*.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
